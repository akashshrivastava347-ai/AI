# Copy to .env and fill in. .env is git-ignored — never commit a real key.
#
# SECURITY: if a key has ever been pasted into a chat, an email, a screenshot or a
# commit, treat it as public and rotate it at https://platform.openai.com/api-keys

LOGSENSE_LLM_PROVIDER=openai          # openai | fake  ("fake" needs no key)
LOGSENSE_LLM_API_KEY=sk-...

# SQLite by default so the service runs with zero setup. Point at PostgreSQL in any
# shared environment:
#   LOGSENSE_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/logsense
LOGSENSE_DATABASE_URL=sqlite+pysqlite:///./logsense.db

LOGSENSE_LLM_MODEL_EXTRACT=gpt-4o-mini
LOGSENSE_LLM_MODEL_REASON=gpt-4o

# Overall confidence at or above which a record skips human review.
LOGSENSE_DEFAULT_AUTO_APPROVE_THRESHOLD=0.80

LOGSENSE_APP_ENV=dev
LOGSENSE_LOG_LEVEL=INFO
